---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TagFilter from "../components/TagFilter.astro";
import { getCollection } from "astro:content";

// Get all projects
const allProjects = await getCollection("projects");
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

// Get all unique tags
const allTags = sortedProjects.flatMap((project) => project.data.tags);
---

<Layout title="Portfolio | Kristy Wong - VFX Artist">
  <Header />

  <main class="pt-24 pb-16 min-h-screen">
    <div class="container mx-auto px-6">
      <!-- Page Header -->
      <div class="mb-12">
        <h1 class="text-5xl font-bold mb-4 text-gray-900">
          My <span class="text-cyan-600">Portfolio</span>
        </h1>
        <p class="text-xl text-gray-500 max-w-2xl">
          Explore my collection of VFX and animation projects. Hover over any
          project to preview the video.
        </p>
      </div>

      <!-- Tag Filter -->
      <TagFilter tags={allTags} />

      <!-- Portfolio Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          sortedProjects.map((project) => (
            <div data-tags={project.data.tags.join(",")}>
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                coverImage={project.data.coverImage}
                videoUrl={project.data.videoUrl}
                tags={project.data.tags}
                slug={project.slug}
              />
            </div>
          ))
        }
      </div>

      <!-- Empty State (shown when no projects match filter) -->
      <div id="empty-state" class="hidden text-center py-16">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-16 w-16 mx-auto text-gray-400 mb-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          ></path>
        </svg>
        <p class="text-gray-500 text-lg">No projects found for this tag.</p>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* Stagger animation for grid items */
  [data-tags] {
    animation: fadeInUp 0.6s ease forwards;
  }

  [data-tags]:nth-child(1) {
    animation-delay: 0.1s;
  }
  [data-tags]:nth-child(2) {
    animation-delay: 0.2s;
  }
  [data-tags]:nth-child(3) {
    animation-delay: 0.3s;
  }
  [data-tags]:nth-child(4) {
    animation-delay: 0.4s;
  }
  [data-tags]:nth-child(5) {
    animation-delay: 0.5s;
  }
  [data-tags]:nth-child(6) {
    animation-delay: 0.6s;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
