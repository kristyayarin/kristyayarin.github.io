---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="About | Kristy Wong - VFX Artist">
  <Header />

  <main class="pt-24 pb-16">
    <div class="container mx-auto px-6">
      <div class="flex flex-col md:flex-row gap-12 items-start">
        <!-- Profile Image -->
        <div class="w-full md:w-1/3">
          <div
            class="aspect-[3/4] rounded-2xl overflow-hidden shadow-2xl relative group"
          >
            <div
              class="absolute inset-0 bg-purple-900/20 group-hover:bg-transparent transition-all duration-500"
            >
            </div>
            <!-- Placeholder for profile image -->
            <div
              class="w-full h-full bg-gray-800 flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-24 w-24 text-gray-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                ></path>
              </svg>
            </div>
          </div>

          <div class="mt-8 bg-gray-800/50 p-6 rounded-xl">
            <h3 class="text-xl font-bold mb-4 text-purple-400">Skills</h3>
            <div class="space-y-4">
              <div>
                <div class="flex justify-between mb-1">
                  <span class="text-gray-300">3D Animation</span>
                  <span class="text-gray-400">95%</span>
                </div>
                <div class="w-full bg-gray-700 rounded-full h-2">
                  <div
                    class="bg-purple-600 h-2 rounded-full"
                    style="width: 95%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between mb-1">
                  <span class="text-gray-300">Visual Effects</span>
                  <span class="text-gray-400">90%</span>
                </div>
                <div class="w-full bg-gray-700 rounded-full h-2">
                  <div
                    class="bg-purple-600 h-2 rounded-full"
                    style="width: 90%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between mb-1">
                  <span class="text-gray-300">Compositing</span>
                  <span class="text-gray-400">85%</span>
                </div>
                <div class="w-full bg-gray-700 rounded-full h-2">
                  <div
                    class="bg-purple-600 h-2 rounded-full"
                    style="width: 85%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between mb-1">
                  <span class="text-gray-300">Motion Graphics</span>
                  <span class="text-gray-400">80%</span>
                </div>
                <div class="w-full bg-gray-700 rounded-full h-2">
                  <div
                    class="bg-purple-600 h-2 rounded-full"
                    style="width: 80%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between mb-1">
                  <span class="text-gray-300">Rigging</span>
                  <span class="text-gray-400">75%</span>
                </div>
                <div class="w-full bg-gray-700 rounded-full h-2">
                  <div
                    class="bg-purple-600 h-2 rounded-full"
                    style="width: 75%"
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- About Content -->
        <div class="lg:col-span-3">
          <div class="prose prose-invert max-w-none">
            <h2>My Story</h2>
            <p>
              Hi, I'm Kristy Wong, a passionate VFX artist with expertise in
              creating stunning visual effects and animations. With over [X]
              years of experience in the industry, I've had the privilege of
              working on a variety of exciting projects across film, television,
              and digital media.
            </p>

            <p>
              My journey began with a fascination for blending art and
              technology to create immersive visual experiences. I graduated
              from [Your University/School] with a degree in [Your Degree],
              which provided me with a strong foundation in both technical
              skills and creative storytelling.
            </p>

            <h2 class="mt-8">Experience</h2>
            <p>
              Throughout my career, I've collaborated with talented teams on
              projects ranging from blockbuster films to innovative digital
              campaigns. My expertise includes [list your specific expertise
              areas like particle simulations, fluid dynamics, character
              animation, etc.].
            </p>

            <p>
              I've worked with leading studios such as [Studio Name] and [Studio
              Name], contributing to projects like [Project Name] and [Project
              Name]. These experiences have honed my ability to deliver
              high-quality visual effects that enhance storytelling and create
              memorable viewer experiences.
            </p>

            <h2 class="mt-8">My Approach</h2>
            <p>
              I believe that great visual effects should seamlessly integrate
              with the narrative, enhancing the story without overpowering it.
              My approach combines technical precision with artistic vision,
              always striving to push the boundaries of what's possible while
              maintaining a focus on the emotional impact of the work.
            </p>

            <p>
              When I'm not creating visual effects, I enjoy [mention hobbies or
              interests that might be relevant], which continuously inspire my
              creative process and bring fresh perspectives to my work.
            </p>

            <div class="mt-8">
              <h2>Software & Tools</h2>
              <div class="flex flex-wrap gap-3 mt-4">
                <span class="px-3 py-1 bg-gray-700 rounded-full text-sm"
                  >Maya</span
                >
                <span class="px-3 py-1 bg-gray-700 rounded-full text-sm"
                  >Houdini</span
                >
                <span class="px-3 py-1 bg-gray-700 rounded-full text-sm"
                  >Nuke</span
                >
                <span class="px-3 py-1 bg-gray-700 rounded-full text-sm"
                  >After Effects</span
                >
                <span class="px-3 py-1 bg-gray-700 rounded-full text-sm"
                  >Cinema 4D</span
                >
                <span class="px-3 py-1 bg-gray-700 rounded-full text-sm"
                  >ZBrush</span
                >
                <span class="px-3 py-1 bg-gray-700 rounded-full text-sm"
                  >Substance Designer</span
                >
                <span class="px-3 py-1 bg-gray-700 rounded-full text-sm"
                  >Unreal Engine</span
                >
              </div>
            </div>
          </div>

          <div class="mt-12">
            <a
              href="/contact"
              class="inline-block px-6 py-3 bg-purple-600 hover:bg-purple-700 rounded-lg text-white font-medium transition"
            >
              Get In Touch
            </a>
            <a
              href="/portfolio"
              class="inline-block px-6 py-3 ml-4 bg-transparent border border-purple-500 hover:bg-purple-900/30 rounded-lg text-white font-medium transition"
            >
              View My Work
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
