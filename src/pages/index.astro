---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

// Get featured projects for the home page
const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(project => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const recentProjects = allProjects
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// Hero video - Vimeo ID
const heroVimeoId = '1082394850';
---

<Layout title="Kristy Wong - VFX Artist Portfolio">
  <Header />
  
  <main>
    <!-- Hero Section with Video Background -->
    <section class="relative h-screen flex items-center overflow-hidden">
      <!-- Vimeo Video Background -->
      <div class="absolute inset-0 z-0">
        <div class="vimeo-wrapper">
          <iframe
            src={`https://player.vimeo.com/video/${heroVimeoId}?background=1&autoplay=1&loop=1&byline=0&title=0&muted=1`}
            frameborder="0"
            allow="autoplay; fullscreen"
            class="vimeo-video"
          ></iframe>
        </div>
        <!-- Light overlay for text visibility -->
        <div class="absolute inset-0 bg-white/30 backdrop-blur-[2px]"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-white/10 via-transparent to-gray-50"></div>
      </div>
      
      <!-- Hero content -->
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-3xl">
          <h1 class="text-6xl md:text-8xl font-bold mb-4 text-white drop-shadow-md">
            Kristy Wong
          </h1>
          <h2 class="text-3xl md:text-4xl font-light text-white/90 mb-6 drop-shadow-sm">VFX Artist & Digital Creator</h2>
          <p class="text-xl text-white/90 mb-8 max-w-xl drop-shadow-sm font-medium">
            Bringing imagination to life through stunning visual effects and creative animations.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/portfolio" class="px-8 py-4 bg-cyan-600 hover:bg-cyan-700 text-white rounded-full font-medium transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-cyan-500/25 border border-cyan-500">
              View My Work
            </a>
            <a href="/contact" class="px-8 py-4 bg-white/20 hover:bg-white/30 backdrop-blur-md border border-white/50 rounded-full text-white font-medium transition-all duration-300 hover:scale-105">
              Get In Touch
            </a>
          </div>
        </div>
      </div>
      
      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-10 animate-bounce">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </section>
    
    <!-- Featured Work Section -->
    <section class="py-24 bg-gray-50">
      <div class="container mx-auto px-6">
        <h2 class="text-4xl font-bold mb-4 text-center text-gray-900">
          Featured <span class="text-cyan-600">Work</span>
        </h2>
        <p class="text-gray-600 text-center mb-12 max-w-2xl mx-auto">
          A selection of my best visual effects and animation projects
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {recentProjects.map(project => (
            <a href={`/portfolio/${project.slug}`} class="group block">
              <div class="bg-white rounded-xl overflow-hidden transition-all duration-500 hover:transform hover:scale-[1.02] hover:shadow-xl hover:shadow-cyan-500/10 border border-gray-200 hover:border-cyan-200">
                <div class="aspect-video relative overflow-hidden">
                  <img 
                    src={project.data.coverImage} 
                    alt={project.data.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                  />
                  <div class="absolute inset-0 bg-cyan-900/0 group-hover:bg-cyan-900/10 transition-all duration-300"></div>
                  
                  <!-- Play icon on hover -->
                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <div class="w-14 h-14 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center shadow-lg">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-cyan-600 ml-1" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </div>
                  </div>
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-bold mb-2 text-gray-900 group-hover:text-cyan-600 transition-colors">{project.data.title}</h3>
                  <p class="text-gray-600 mb-4 line-clamp-2">{project.data.description}</p>
                  
                  <div class="flex flex-wrap gap-2">
                    {project.data.tags.slice(0, 3).map(tag => (
                      <span class="px-3 py-1 bg-gray-100 rounded-full text-xs text-gray-600 font-medium border border-gray-200">{tag}</span>
                    ))}
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
        
        <div class="mt-12 text-center">
          <a href="/portfolio" class="inline-flex items-center gap-2 px-8 py-4 bg-white border border-gray-200 text-gray-700 hover:text-cyan-600 hover:border-cyan-200 rounded-full font-medium transition-all duration-300 hover:shadow-md">
            View All Projects
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  /* Vimeo video background styles */
  .vimeo-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
  }
  
  .vimeo-video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 177.78vh; /* 16:9 aspect ratio */
    height: 100vh;
    min-width: 100%;
    min-height: 56.25vw; /* 16:9 aspect ratio */
    transform: translate(-50%, -50%);
  }
</style>
