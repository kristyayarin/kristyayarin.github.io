---
import Link from "@components/Links.astro";
import { FooterLinks, SocialLinks } from "@consts";
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-gray-200 bg-gray-50">
	<div class="container mx-auto px-6 py-12">
		<div class="flex flex-col items-center gap-8 sm:flex-row sm:justify-between">
			<!-- Copyright -->
			<div class="text-center sm:text-left">
				<a
					class="text-lg font-semibold text-gray-900 transition-colors hover:text-gray-600"
					href="/"
				>
					Kristy Wong
				</a>
				<p class="mt-1 text-sm text-gray-500">
					&copy; {currentYear} All rights reserved.
				</p>
			</div>

			<!-- Footer Links -->
			<div class="flex flex-row gap-6">
				{
					FooterLinks.map((link) => (
						<Link
							href={link.href}
							class="text-sm text-gray-500 transition-colors hover:text-gray-900"
						>
							{link.title}
						</Link>
					))
				}
			</div>

			<!-- Social Icons -->
			<div class="flex flex-wrap gap-3">
				{
					SocialLinks.map((link) => (
						<a
							href={link.href}
							target="_blank"
							rel="noopener noreferrer"
							class="social-icon flex h-10 w-10 items-center justify-center rounded-full bg-gray-200 transition-all duration-200 hover:bg-gray-300"
							aria-label={link.label}
						>
							<img src={link.icon.src} alt={link.label} class="h-5 w-5" />
						</a>
					))
				}
			</div>
		</div>
	</div>
</footer>
