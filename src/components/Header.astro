---
// Get the current path to highlight active navigation
const currentPath = Astro.url.pathname;
const isHomePage = currentPath === "/";

const navLinks = [
	{ href: "/", label: "Home" },
	{ href: "/reel", label: "Reel" },
	{ href: "/showcase", label: "Showcase" },
	{ href: "/blog", label: "Blog" },
	{ href: "/about", label: "About" },
	{ href: "/contact", label: "Contact" },
];

// Helper to check if a link is active
const isActive = (href: string) => {
	if (href === "/") {
		return currentPath === "/";
	}
	return currentPath.startsWith(href);
};

import logo from "../assets/LOGOtext.png";
---

<header
	id="main-header"
	class:list={[
		"fixed z-50 w-full transition-all duration-300",
		isHomePage ? "header-transparent" : "border-b border-gray-200 bg-white/95 backdrop-blur-md",
	]}
	data-is-home={isHomePage}
>
	<div class="container mx-auto flex items-center justify-between px-6 py-3">
		<a href="/" class="flex items-center gap-2 transition-opacity hover:opacity-80">
			<img src={logo.src} alt="Xuan(Kristy) Huang" class="header-logo h-8" />
		</a>

		<nav>
			<ul class="m-0 flex list-none items-center gap-2 p-0">
				{
					navLinks.map((link) => (
						<li class="list-none">
							<a
								href={link.href}
								class:list={[
									"nav-link block rounded-full px-4 py-2 text-sm font-medium transition-all duration-200",
									isActive(link.href)
										? isHomePage
											? "bg-white/20 text-white backdrop-blur-sm"
											: "bg-gray-900 text-white"
										: isHomePage
											? "text-white/90 hover:bg-white/10 hover:text-white"
											: "text-gray-600 hover:bg-gray-100 hover:text-gray-900",
								]}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	nav li {
		list-style: none;
	}

	.header-transparent {
		background: transparent;
		border-bottom: 1px solid transparent;
	}

	.header-scrolled {
		background: rgba(255, 255, 255, 0.95);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid #e5e7eb;
	}

	.header-scrolled .nav-link {
		color: #4b5563 !important;
	}

	.header-scrolled .nav-link:hover {
		background: #f3f4f6 !important;
		color: #111827 !important;
	}

	.header-scrolled .nav-link.active {
		background: #111827 !important;
		color: #fff !important;
	}

	/* Invert logo when scrolled on homepage */
	.header-scrolled .header-logo {
		filter: none;
	}

	.header-transparent .header-logo {
		filter: brightness(0) invert(1);
	}
</style>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const header = document.getElementById("main-header");
		const isHomePage = header?.getAttribute("data-is-home") === "true";

		if (isHomePage && header) {
			const navLinks = header.querySelectorAll(".nav-link");
			const activeLink = header.querySelector(".nav-link.bg-white\\/20");

			const handleScroll = () => {
				if (window.scrollY > 50) {
					header.classList.remove("header-transparent");
					header.classList.add("header-scrolled");

					// Update nav link styles for scrolled state
					navLinks.forEach((link) => {
						if (link === activeLink) {
							link.classList.remove("bg-white/20", "text-white", "backdrop-blur-sm");
							link.classList.add("bg-gray-900", "text-white", "active");
						} else {
							link.classList.remove(
								"text-white/90",
								"hover:bg-white/10",
								"hover:text-white",
							);
							link.classList.add("text-gray-600");
						}
					});
				} else {
					header.classList.add("header-transparent");
					header.classList.remove("header-scrolled");

					// Restore nav link styles for transparent state
					navLinks.forEach((link) => {
						if (link === activeLink) {
							link.classList.add("bg-white/20", "text-white", "backdrop-blur-sm");
							link.classList.remove("bg-gray-900", "active");
						} else {
							link.classList.add("text-white/90");
							link.classList.remove("text-gray-600");
						}
					});
				}
			};

			window.addEventListener("scroll", handleScroll);
			handleScroll(); // Initial check
		}
	});
</script>
