---
// Get the current path to highlight active navigation
const currentPath = Astro.url.pathname;
const isHomePage = currentPath === "/";

const navLinks = [
	{ href: "/", label: "Home" },
	{ href: "/reel", label: "Reel" },
	{ href: "/showcase", label: "Showcase" },
	{ href: "/blog", label: "Blog" },
	{ href: "/about", label: "About" },
	{ href: "/contact", label: "Contact" },
];

// Helper to check if a link is active
const isActive = (href: string) => {
	if (href === "/") {
		return currentPath === "/";
	}
	return currentPath.startsWith(href);
};

import logo from "../assets/LOGOtext.png";
---

<header
	id="main-header"
	class:list={[
		"fixed z-50 w-full transition-all duration-300",
		isHomePage ? "header-transparent" : "border-b border-gray-200 bg-white/95 backdrop-blur-md",
	]}
	data-is-home={isHomePage}
>
	<div class="container mx-auto flex items-center justify-between px-6 py-3">
		<a href="/" class="flex items-center gap-2 transition-opacity hover:opacity-80">
			<img src={logo.src} alt="Xuan(Kristy) Huang" class="header-logo h-8" />
		</a>

		<!-- Desktop Navigation -->
		<nav class="hidden md:block" id="desktop-nav">
			<ul class="m-0 flex list-none items-center gap-2 p-0">
				{
					navLinks.map((link) => (
						<li class="list-none">
							<a
								href={link.href}
								class:list={[
									"nav-link block rounded-full px-4 py-2 text-sm font-medium transition-all duration-200",
									isActive(link.href)
										? isHomePage
											? "bg-white/20 text-white backdrop-blur-sm"
											: "bg-gray-900 text-white"
										: isHomePage
											? "text-white/90 hover:bg-white/10 hover:text-white"
											: "text-gray-600 hover:bg-gray-100 hover:text-gray-900",
								]}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<!-- Mobile Hamburger Button -->
		<button
			id="mobile-menu-btn"
			class="hamburger-btn md:hidden"
			aria-expanded="false"
			aria-controls="mobile-menu"
			aria-label="Toggle navigation menu"
		>
			<span class="hamburger-line line-1"></span>
			<span class="hamburger-line line-2"></span>
			<span class="hamburger-line line-3"></span>
		</button>
	</div>

	<!-- Mobile Menu Panel -->
	<div id="mobile-menu" class="mobile-menu md:hidden" aria-hidden="true">
		<nav>
			<ul class="m-0 flex list-none flex-col p-0">
				{
					navLinks.map((link) => (
						<li class="list-none">
							<a
								href={link.href}
								class:list={[
									"mobile-nav-link block px-6 py-3 text-base font-medium transition-all duration-200",
									isActive(link.href) ? "mobile-nav-active" : "",
								]}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	nav li {
		list-style: none;
	}

	.header-transparent {
		background: transparent;
		border-bottom: 1px solid transparent;
	}

	.header-scrolled {
		background: rgba(255, 255, 255, 0.95);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid #e5e7eb;
	}

	.header-scrolled .nav-link {
		color: #4b5563 !important;
	}

	.header-scrolled .nav-link:hover {
		background: #f3f4f6 !important;
		color: #111827 !important;
	}

	.header-scrolled .nav-link.active {
		background: #111827 !important;
		color: #fff !important;
	}

	/* Invert logo when scrolled on homepage */
	.header-scrolled .header-logo {
		filter: none;
	}

	.header-transparent .header-logo {
		filter: brightness(0) invert(1);
	}

	/* ========================================
	   Hamburger Button
	   ======================================== */
	.hamburger-btn {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		width: 36px;
		height: 36px;
		padding: 0;
		background: none;
		border: none;
		cursor: pointer;
		z-index: 60;
		border-radius: 6px;
		transition: background 0.2s ease;
	}

	/* Hide hamburger & mobile menu on desktop (md: 768px+) */
	@media screen and (min-width: 768px) {
		.hamburger-btn {
			display: none;
		}
		.mobile-menu {
			display: none;
		}
	}

	.hamburger-btn:hover {
		background: rgba(128, 128, 128, 0.15);
	}

	.hamburger-line {
		display: block;
		width: 22px;
		height: 2px;
		border-radius: 1px;
		transition:
			transform 0.3s ease,
			opacity 0.3s ease;
	}

	.line-1 {
		transform: translateY(-4px);
	}
	.line-2 {
		transform: translateY(0);
	}
	.line-3 {
		transform: translateY(4px);
	}

	/* Hamburger line colors — adapt to header state */
	.header-transparent .hamburger-line {
		background-color: #fff;
	}

	.header-scrolled .hamburger-line,
	#main-header:not(.header-transparent) .hamburger-line {
		background-color: #374151;
	}

	/* Hamburger → X animation when open */
	.hamburger-btn[aria-expanded="true"] .line-1 {
		transform: translateY(2px) rotate(45deg);
	}
	.hamburger-btn[aria-expanded="true"] .line-2 {
		opacity: 0;
	}
	.hamburger-btn[aria-expanded="true"] .line-3 {
		transform: translateY(-2px) rotate(-45deg);
	}

	/* ========================================
	   Mobile Menu Panel
	   ======================================== */
	.mobile-menu {
		max-height: 0;
		overflow: hidden;
		transition:
			max-height 0.35s ease,
			opacity 0.3s ease;
		opacity: 0;
	}

	.mobile-menu.is-open {
		max-height: 400px;
		opacity: 1;
	}

	/* Mobile menu styling — homepage transparent state */
	.header-transparent .mobile-menu {
		background: rgba(0, 0, 0, 0.85);
		backdrop-filter: blur(16px);
	}

	.header-transparent .mobile-nav-link {
		color: rgba(255, 255, 255, 0.85);
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.header-transparent .mobile-nav-link:hover {
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
	}

	.header-transparent .mobile-nav-active {
		color: #fff;
		background: rgba(255, 255, 255, 0.15);
	}

	/* Mobile menu styling — homepage scrolled state */
	.header-scrolled .mobile-menu {
		background: rgba(255, 255, 255, 0.98);
		backdrop-filter: blur(16px);
		border-top: 1px solid #e5e7eb;
	}

	.header-scrolled .mobile-nav-link {
		color: #4b5563;
		border-bottom: 1px solid #f3f4f6;
	}

	.header-scrolled .mobile-nav-link:hover {
		background: #f3f4f6;
		color: #111827;
	}

	.header-scrolled .mobile-nav-active {
		color: #111827;
		background: #f3f4f6;
		font-weight: 600;
	}

	/* Mobile menu styling — non-homepage (white bg header) */
	#main-header:not(.header-transparent):not(.header-scrolled) .mobile-menu {
		background: rgba(255, 255, 255, 0.98);
		backdrop-filter: blur(16px);
		border-top: 1px solid #e5e7eb;
	}

	#main-header:not(.header-transparent):not(.header-scrolled) .mobile-nav-link {
		color: #4b5563;
		border-bottom: 1px solid #f3f4f6;
	}

	#main-header:not(.header-transparent):not(.header-scrolled) .mobile-nav-link:hover {
		background: #f3f4f6;
		color: #111827;
	}

	#main-header:not(.header-transparent):not(.header-scrolled) .mobile-nav-active {
		color: #111827;
		background: #f3f4f6;
		font-weight: 600;
	}
</style>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const header = document.getElementById("main-header");
		const isHomePage = header?.getAttribute("data-is-home") === "true";
		const menuBtn = document.getElementById("mobile-menu-btn");
		const mobileMenu = document.getElementById("mobile-menu");

		// ========================================
		// Mobile menu toggle
		// ========================================
		function toggleMobileMenu() {
			if (!menuBtn || !mobileMenu) return;

			const isExpanded = menuBtn.getAttribute("aria-expanded") === "true";
			menuBtn.setAttribute("aria-expanded", `${!isExpanded}`);
			mobileMenu.setAttribute("aria-hidden", `${isExpanded}`);

			if (!isExpanded) {
				mobileMenu.classList.add("is-open");
			} else {
				mobileMenu.classList.remove("is-open");
			}
		}

		function closeMobileMenu() {
			if (!menuBtn || !mobileMenu) return;
			menuBtn.setAttribute("aria-expanded", "false");
			mobileMenu.setAttribute("aria-hidden", "true");
			mobileMenu.classList.remove("is-open");
		}

		menuBtn?.addEventListener("click", toggleMobileMenu);

		// Close menu when a mobile nav link is clicked
		mobileMenu?.querySelectorAll(".mobile-nav-link").forEach((link) => {
			link.addEventListener("click", closeMobileMenu);
		});

		// Close menu when window resizes past the md breakpoint (768px)
		window.addEventListener("resize", () => {
			if (window.innerWidth >= 768) {
				closeMobileMenu();
			}
		});

		// ========================================
		// Homepage scroll-based header styling
		// ========================================
		if (isHomePage && header) {
			const navLinks = header.querySelectorAll("#desktop-nav .nav-link");
			const activeLink = header.querySelector("#desktop-nav .nav-link.bg-white\\/20");

			const handleScroll = () => {
				if (window.scrollY > 50) {
					header.classList.remove("header-transparent");
					header.classList.add("header-scrolled");

					// Update nav link styles for scrolled state
					navLinks.forEach((link) => {
						if (link === activeLink) {
							link.classList.remove("bg-white/20", "text-white", "backdrop-blur-sm");
							link.classList.add("bg-gray-900", "text-white", "active");
						} else {
							link.classList.remove(
								"text-white/90",
								"hover:bg-white/10",
								"hover:text-white",
							);
							link.classList.add("text-gray-600");
						}
					});
				} else {
					header.classList.add("header-transparent");
					header.classList.remove("header-scrolled");

					// Restore nav link styles for transparent state
					navLinks.forEach((link) => {
						if (link === activeLink) {
							link.classList.add("bg-white/20", "text-white", "backdrop-blur-sm");
							link.classList.remove("bg-gray-900", "active");
						} else {
							link.classList.add("text-white/90");
							link.classList.remove("text-gray-600");
						}
					});
				}
			};

			window.addEventListener("scroll", handleScroll);
			handleScroll(); // Initial check
		}
	});
</script>
