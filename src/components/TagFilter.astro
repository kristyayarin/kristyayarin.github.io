---
interface Props {
    tags: string[];
    activeTag?: string;
}

const { tags, activeTag = "all" } = Astro.props;

// Get unique tags sorted alphabetically
const uniqueTags = [...new Set(tags)].sort();
---

<div class="tag-filter flex flex-wrap gap-3 mb-10">
    <button
        class:list={[
            "tag-button px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-300",
            activeTag === "all"
                ? "bg-purple-600 text-white shadow-lg shadow-purple-500/25"
                : "bg-gray-700/50 text-gray-300 hover:bg-gray-600/50 hover:text-white",
        ]}
        data-tag="all"
    >
        All Projects
    </button>

    {
        uniqueTags.map((tag) => (
            <button
                class:list={[
                    "tag-button px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-300",
                    activeTag === tag
                        ? "bg-purple-600 text-white shadow-lg shadow-purple-500/25"
                        : "bg-gray-700/50 text-gray-300 hover:bg-gray-600/50 hover:text-white",
                ]}
                data-tag={tag}
            >
                {tag}
            </button>
        ))
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const tagButtons = document.querySelectorAll(".tag-button");
        const projectCards = document.querySelectorAll("[data-tags]");

        tagButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const selectedTag = button.getAttribute("data-tag");

                // Update active button styles
                tagButtons.forEach((btn) => {
                    btn.classList.remove(
                        "bg-purple-600",
                        "text-white",
                        "shadow-lg",
                        "shadow-purple-500/25",
                    );
                    btn.classList.add("bg-gray-700/50", "text-gray-300");
                });
                button.classList.remove("bg-gray-700/50", "text-gray-300");
                button.classList.add(
                    "bg-purple-600",
                    "text-white",
                    "shadow-lg",
                    "shadow-purple-500/25",
                );

                // Filter projects
                projectCards.forEach((card) => {
                    const cardTags =
                        card.getAttribute("data-tags")?.split(",") || [];
                    const cardElement = card as HTMLElement;

                    if (
                        selectedTag === "all" ||
                        cardTags.includes(selectedTag!)
                    ) {
                        cardElement.style.display = "block";
                        cardElement.style.animation = "fadeIn 0.4s ease";
                    } else {
                        cardElement.style.display = "none";
                    }
                });
            });
        });
    });
</script>

<style>
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
